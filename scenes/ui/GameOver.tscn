[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_over.gd" id="1_gameover"]
[ext_resource type="Theme" path="res://themes/cyberpunk_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_newlife_normal"]
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0
bg_color = Color(0.024, 0.12, 0.048, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 1, 0.4, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_newlife_hover"]
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0
bg_color = Color(0.048, 0.12, 0.072, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.4, 1, 0.6, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="GameOver" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_gameover")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0.07, 0.04, 1)
show_behind_parent = true

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 60

[node name="RootVBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="Label" parent="Margin/RootVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 56
horizontal_alignment = 1
text = "◢ GAME OVER ◣"

[node name="Rule" type="ColorRect" parent="Margin/RootVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 1)
color = Color(0, 0.55, 0.3, 0.5)

[node name="FlavourLabel" type="Label" parent="Margin/RootVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.2, 1)
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1
text = "The run ended."

[node name="SummaryCard" type="PanelContainer" parent="Margin/RootVBox"]
layout_mode = 2

[node name="CardVBox" type="VBoxContainer" parent="Margin/RootVBox/SummaryCard"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="RunSummaryHeader" type="Label" parent="Margin/RootVBox/SummaryCard/CardVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 1, 0.6, 1)
theme_override_font_sizes/font_size = 27
text = "RUN SUMMARY"

[node name="TraceLabel" type="Label" parent="Margin/RootVBox/SummaryCard/CardVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Trace reached: 0"

[node name="CreditsLabel" type="Label" parent="Margin/RootVBox/SummaryCard/CardVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Credits lost: 0 eb"

[node name="LootLabel" type="Label" parent="Margin/RootVBox/SummaryCard/CardVBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Loot lost: 0 program(s)"

[node name="DatafortLabel" type="Label" parent="Margin/RootVBox/SummaryCard/CardVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.58, 0.5, 1)
text = "Datafort: —"

[node name="CatalogueNote" type="Label" parent="Margin/RootVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 1, 0.6, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
text = "Your contacts keep your discovered software in the catalogue. Next life, you can rebuy it at the hub."

[node name="Spacer" type="Control" parent="Margin/RootVBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ButtonRow" type="HBoxContainer" parent="Margin/RootVBox"]
layout_mode = 2
alignment = 1

[node name="NewLifeButton" type="Button" parent="Margin/RootVBox/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.05, 0.02, 1)
theme_override_colors/font_hover_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 30
theme_override_styles/normal = SubResource("StyleBoxFlat_newlife_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_newlife_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_newlife_normal")
text = "[ NEW LIFE ]"

[connection signal="pressed" from="Margin/RootVBox/ButtonRow/NewLifeButton" to="." method="_on_new_life_pressed"]